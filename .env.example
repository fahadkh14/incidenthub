# ===========================================================================
# IncidentHub environment configuration
# Copy this file to `.env` and change every "change_me" value before running.
# Never commit your real `.env` file.
# ===========================================================================

# --- MySQL ---
MYSQL_DATABASE=incidenthub
MYSQL_USER=incidenthub
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

DB_HOST=mysql
DB_PORT=3306

# --- Backend / JWT ---
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_secure_random_secret
JWT_EXPIRES_IN=1d

BACKEND_PORT=5673

# --- Frontend ---
FRONTEND_PORT=8070

# --- Nginx (this is the port you will open in your browser) ---
NGINX_PORT=8080
